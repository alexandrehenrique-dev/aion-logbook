# Configuração aplicada automaticamente pelo build:backend (npm run build:backend).
# Este arquivo não contém secrets — apenas valores de build para modo produtivo.
# Variáveis de ambiente sensíveis (KEYCLOAK_URL, CLIENT_ID) devem ser injetadas
# pelo CI/CD ou pelo servidor via variáveis de ambiente de build.

# Modo real: sem MSW, sem mocks, todas as chamadas vão para o backend
VITE_API_MODE=real

# Em produção com frontend servido pelo Spring Boot, usar caminho relativo
VITE_API_BASE_URL=/logbook/api/v1

# Base path do frontend — deve bater com SERVER_CONTEXT_PATH no backend
VITE_BASE_PATH=/logbook/

# Keycloak obrigatório em produção
VITE_AUTH_MODE=keycloak
VITE_KEYCLOAK_ENABLED=true

# VITE_KEYCLOAK_URL NÃO deve ser definido aqui — injetar via variável de ambiente no CI/CD
# ou via build arg do Docker (VITE_KEYCLOAK_URL no docker-compose.yml).
# Exemplo Docker: docker compose up --build (usa VITE_KEYCLOAK_URL do .env)
# Exemplo direto: VITE_KEYCLOAK_URL=https://seu-host/keycloak npm run build:backend
VITE_KEYCLOAK_REALM=aion-logbook
VITE_KEYCLOAK_CLIENT_ID=aion-logbook-web

# Módulo de notificações desabilitado até o backend implementar /api/v1/notifications
VITE_ENABLE_NOTIFICATIONS=false
