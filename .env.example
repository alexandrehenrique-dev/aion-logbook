# ═══════════════════════════════════════════════════════════════════
# Aion Logbook — Variáveis de ambiente
# Copie para .env e preencha os valores reais (nunca commite .env)
# ═══════════════════════════════════════════════════════════════════

# ── Banco de dados ──────────────────────────────────────────────────
POSTGRES_DB=aion_logbook
POSTGRES_USER=aion_user
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

# ── Keycloak ────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_PORT=8181
KEYCLOAK_REALM=aion-logbook
KEYCLOAK_FRONTEND_CLIENT_ID=aion-logbook-web
KEYCLOAK_PUBLIC_URL=http://localhost:8181
# Em produção: KEYCLOAK_PUBLIC_URL=https://auth.genesis-lab.dev

# ── Login Social — Google ───────────────────────────────────────────
# Obter em: https://console.cloud.google.com/apis/credentials
# Redirect URI a registrar no Google Console:
#   http://localhost:8181/realms/aion-logbook/broker/google/endpoint
#   https://auth.genesis-lab.dev/realms/aion-logbook/broker/google/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Login Social — Microsoft / Outlook ─────────────────────────────
# Obter em: https://portal.azure.com → App registrations
# Redirect URI a registrar no Azure:
#   http://localhost:8181/realms/aion-logbook/broker/microsoft/endpoint
#   https://auth.genesis-lab.dev/realms/aion-logbook/broker/microsoft/endpoint
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ── Login Social — Apple ────────────────────────────────────────────
# Obter em: https://developer.apple.com
# ATENÇÃO: Apple exige HTTPS com domínio válido — não funciona em localhost
# Redirect URI a registrar na Apple:
#   https://auth.genesis-lab.dev/realms/aion-logbook/broker/apple/endpoint
# APPLE_CLIENT_SECRET: conteúdo da chave privada .p8 (ou JWT pré-gerado)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_SECRET=
# APPLE_PRIVATE_KEY_PATH=/run/secrets/apple_key.p8
