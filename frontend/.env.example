# ─────────────────────────────────────────────
# API MODE
# mock  → MSW intercepta todas as chamadas (sem backend)
# real  → httpClient usa VITE_API_BASE_URL (backend rodando)
# ─────────────────────────────────────────────
VITE_API_MODE=mock

# Base URL da API. Padrão: /api/v1 (servido pelo Spring Boot ou MSW local)
# Em desenvolvimento local com backend rodando:
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ─────────────────────────────────────────────
# AUTH MODE
# mock     → login local sem Keycloak (qualquer clique em "Entrar" autentica)
# keycloak → Authorization Code Flow + PKCE via Keycloak
# ─────────────────────────────────────────────
VITE_AUTH_MODE=mock

# Keycloak — necessário apenas quando VITE_AUTH_MODE=keycloak
VITE_KEYCLOAK_ENABLED=false
VITE_KEYCLOAK_URL=http://localhost:8181
VITE_KEYCLOAK_REALM=aion-logbook
VITE_KEYCLOAK_CLIENT_ID=aion-logbook-web

# ─────────────────────────────────────────────
# FEATURE FLAGS
# Manter false até o módulo existir no backend.
# ─────────────────────────────────────────────
# Notificações — GET /api/v1/notifications ainda não implementado no backend
VITE_ENABLE_NOTIFICATIONS=false

# ─────────────────────────────────────────────
# COMBINAÇÕES VÁLIDAS
#
# Desenvolvimento puro (sem Keycloak, sem backend):
#   VITE_API_MODE=mock
#   VITE_AUTH_MODE=mock
#
# Keycloak local + dados mockados (backend ainda não existe):
#   VITE_API_MODE=mock
#   VITE_AUTH_MODE=keycloak
#   VITE_KEYCLOAK_ENABLED=true
#
# Backend Spring completo:
#   VITE_API_MODE=real
#   VITE_API_BASE_URL=http://localhost:8080/api/v1
#   VITE_AUTH_MODE=keycloak
#   VITE_KEYCLOAK_ENABLED=true
#
# Produção:
#   VITE_API_MODE=real
#   VITE_API_BASE_URL=https://api.aion.app/api/v1
#   VITE_AUTH_MODE=keycloak
#   VITE_KEYCLOAK_ENABLED=true
#   VITE_KEYCLOAK_URL=https://auth.aion.app
# ─────────────────────────────────────────────
