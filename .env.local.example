# ═══════════════════════════════════════════════════════════════════
# Aion Logbook — Ambiente LOCAL
# Copie para .env e ajuste conforme necessário.
#
# Subir infraestrutura local:
#   docker compose -f docker-compose.local.yml up -d
#
# Backend:
#   cd backend && mvn spring-boot:run -Dspring.profiles.active=local
#
# Frontend (modo dev com Keycloak real):
#   cd frontend && npm run dev
#   (configure VITE_AUTH_MODE=keycloak e VITE_KEYCLOAK_URL=http://localhost:8181)
# ═══════════════════════════════════════════════════════════════════

# ── Banco de dados ──────────────────────────────────────────────────
POSTGRES_DB=aion_logbook
POSTGRES_USER=aion_user
POSTGRES_PASSWORD=aion_password
POSTGRES_PORT=5433

# ── Keycloak local ──────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8181

# ── Backend (application-local.yml já define, mas pode sobrescrever) ─
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
