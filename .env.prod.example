# ═══════════════════════════════════════════════════════════════════
# Aion Logbook — Ambiente PRODUÇÃO (Genesis Lab / servidor)
# Copie para .env e preencha TODOS os valores obrigatórios.
#
# Deploy seguro (NÃO apaga dados):
#   docker compose pull && docker compose up -d --build
#
# NUNCA use em deploy normal:
#   docker compose down -v   ← apaga volumes e PERDE usuários/dados
# ═══════════════════════════════════════════════════════════════════

# ── Banco de dados da aplicação ────────────────────────────────────
POSTGRES_DB=aion_logbook
POSTGRES_USER=aion_user
POSTGRES_PASSWORD=TROQUE_AQUI_POR_SENHA_FORTE
POSTGRES_PORT=5433

# ── Keycloak ────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=TROQUE_AQUI_POR_SENHA_FORTE
KEYCLOAK_PORT=8181

# URL pública do Keycloak vista pelos browsers e pelo backend.
# Deve coincidir com o que o nginx roteia (ex: https://192.168.0.77/keycloak
# ou https://meudominio.com/keycloak).
KC_HOSTNAME=https://192.168.0.77/keycloak

# ── Backend (validação JWT) ─────────────────────────────────────────
# issuer-uri: URL pública do realm. Deve bater com o claim 'iss' dos tokens.
# Formato: ${KC_HOSTNAME}/realms/aion-logbook
KEYCLOAK_ISSUER_URI=https://192.168.0.77/keycloak/realms/aion-logbook

# CORS: origens permitidas pelo backend (separadas por vírgula).
CORS_ALLOWED_ORIGINS=https://192.168.0.77

# ── Frontend (compilado na imagem Docker) ──────────────────────────
# URL do Keycloak vista pelo browser do usuário final.
VITE_KEYCLOAK_URL=https://192.168.0.77/keycloak
VITE_KEYCLOAK_REALM=aion-logbook
VITE_KEYCLOAK_CLIENT_ID=aion-logbook-web

# Base path se a aplicação rodar em subpath (ex: /logbook/).
VITE_BASE_PATH=/logbook/
VITE_API_BASE_URL=/logbook/api/v1

# ── Porta e context path do app ────────────────────────────────────
APP_PORT=8077
SERVER_CONTEXT_PATH=/logbook
SWAGGER_ENABLED=false
