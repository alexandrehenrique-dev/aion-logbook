# Build para full-stack local: backend Spring Boot (porta 8080) + Keycloak local (porta 8181).
# Usar: npm run build:backend:local
#
# DIFERENÇAS do .env.backend (prod):
#   - VITE_API_BASE_URL=/api/v1         (sem /logbook/ — context-path local é /)
#   - VITE_BASE_PATH=/                  (app na raiz, não em /logbook/)
#   - VITE_KEYCLOAK_URL local           (Keycloak rodando em localhost:8181)

VITE_API_MODE=real
VITE_API_BASE_URL=/api/v1
VITE_BASE_PATH=/

VITE_AUTH_MODE=keycloak
VITE_KEYCLOAK_ENABLED=true
VITE_KEYCLOAK_URL=http://localhost:8181
VITE_KEYCLOAK_REALM=aion-logbook
VITE_KEYCLOAK_CLIENT_ID=aion-logbook-web

VITE_ENABLE_NOTIFICATIONS=false
