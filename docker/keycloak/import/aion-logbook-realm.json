{
  "clientId": "aion-logbook-web",
  "name": "Aion Logbook Web",
  "description": "Public SPA client for Aion Logbook frontend.",
  "enabled": true,
  "publicClient": true,
  "protocol": "openid-connect",
  "clientAuthenticatorType": "client-secret",
  "redirectUris": [
    "http://localhost:5173/*",
    "http://localhost:8080/*",
    "https://192.168.0.77/logbook/*",
    "https://192.168.0.77:8077/logbook/*",
    "https://aion.byop.dev/logbook/*",
    "https://aion.byop.dev/logbook/login",
    "https://aion.byop.dev/logbook/login/*"
  ],
  "webOrigins": [
    "http://localhost:5173",
    "http://localhost:8080",
    "https://192.168.0.77",
    "https://192.168.0.77:8077",
    "https://aion.byop.dev"
  ],
  "standardFlowEnabled": true,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
  "frontchannelLogout": true,
  "attributes": {
    "pkce.code.challenge.method": "S256",
    "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:8080/*##https://192.168.0.77/logbook/*##https://192.168.0.77:8077/logbook/*##https://aion.byop.dev/logbook/*##https://aion.byop.dev/logbook/login",
    "oauth2.device.authorization.grant.enabled": "false",
    "oidc.ciba.grant.enabled": "false"
  },
  "defaultClientScopes": [
    "web-origins",
    "acr",
    "basic",
    "profile",
    "roles",
    "email"
  ],
  "optionalClientScopes": [
    "address",
    "phone",
    "offline_access",
    "microprofile-jwt"
  ],
  "rootUrl": "https://aion.byop.dev/logbook/",
  "baseUrl": "https://aion.byop.dev/logbook/",
  "adminUrl": ""
}